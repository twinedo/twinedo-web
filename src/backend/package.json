{
  "name": "backend",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "npx prisma generate --no-engine && npx tsc",
    "dev": "npx tsx watch index.ts",
    "start": "node dist/vercel.js",
    "db:generate": "npx prisma generate --no-engine",
    "db:migrate": "npx prisma migrate deploy",
    "postinstall": "npx prisma generate --no-engine"
  },
  "devDependencies": {
    "@prisma/client": "^6.12.0",
    "@types/bun": "latest",
    "prisma": "^6.12.0",
    "@types/bcryptjs": "^2.4.6",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@elysiajs/bearer": "^1.3.0",
    "@elysiajs/cors": "^1.3.3",
    "@elysiajs/jwt": "^1.3.1",
    "@elysiajs/static": "^1.3.0",
    "@elysiajs/swagger": "^1.3.0",
    "@prisma/extension-accelerate": "^2.0.2",
    "elysia": "^1.3.4",
    "bcryptjs": "^2.4.3"
  }
}
